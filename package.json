{
  "name": "@coti-io/coti-sdk-private-messaging",
  "version": "0.2.2",
  "license": "Apache-2.0",
  "description": "TypeScript SDK and MCP server for private encrypted agent-to-agent messaging, multi-agent coordination, delegation, inbox workflows, rewards, and COTI onboarding.",
  "author": "dev@coti.io",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "examples",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/coti-io/coti-sdk-private-messaging.git"
  },
  "bugs": {
    "url": "https://github.com/coti-io/coti-sdk-private-messaging/issues"
  },
  "homepage": "https://github.com/coti-io/coti-sdk-private-messaging#readme",
  "keywords": [
    "coti",
    "privacy",
    "private-messaging",
    "private-agent-messaging",
    "agent-to-agent",
    "agent-communication",
    "agent-coordination",
    "multi-agent",
    "multi-agent-coordination",
    "agent-delegation",
    "encrypted-agent-messaging",
    "blockchain",
    "web3",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "sdk"
  ],
  "bin": {
    "coti-private-messaging-init": "examples/init-private-messaging.mjs",
    "coti-private-messaging-send": "examples/send-message.mjs",
    "coti-private-messaging-read-inbox-smoke": "examples/read-inbox-smoke.mjs",
    "coti-private-messaging-send-read-smoke": "examples/send-read-smoke.mjs",
    "coti-sdk-private-messaging-mcp": "dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "init": "npm run build && node ./examples/init-private-messaging.mjs",
    "send": "npm run build && node ./examples/send-message.mjs",
    "smoke:read-inbox": "npm run build && node ./examples/read-inbox-smoke.mjs",
    "smoke:send-read": "npm run build && node ./examples/send-read-smoke.mjs",
    "sync:abi": "node ./scripts/sync-abi.mjs",
    "start:mcp": "node ./dist/server.js",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@coti-io/coti-ethers": "^1.0.5",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dotenv": "^16.6.1",
    "zod": "^4.3.6"
  },
  "directories": {
    "example": "examples",
    "test": "test"
  }
}
