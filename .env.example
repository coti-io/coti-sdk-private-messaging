# Optional for first-run setup.
# `npm run init` or `npx -p @coti-io/coti-sdk-private-messaging coti-private-messaging-init` fills missing PRIVATE_KEY and AES_KEY.
PRIVATE_KEY=
AES_KEY=
COTI_NETWORK=mainnet

# Optional for the smoke script. Defaults to 0x000000000000000000000000000000000000c0a1.
# Set this to a real second wallet when testing receiver-side inbox/decryption.
RECIPIENT_ADDRESS=
SMOKE_MESSAGE_TEXT=
INBOX_LIMIT=10

PRIVATE_MESSAGING_CONTRACT_ADDRESS_OVERRIDE=
COTI_RPC_URL_OVERRIDE=
COTI_TESTNET_RPC_URL_OVERRIDE=
COTI_MAINNET_RPC_URL_OVERRIDE=

STARTER_GRANT_SERVICE_URL=
STARTER_GRANT_SERVICE_TIMEOUT_MS=15000
STARTER_GRANT_SERVICE_AUTH_TOKEN=
STARTER_GRANT_INSTALL_ID_PATH=~/.config/coti-sdk-private-messaging/install-state.json
